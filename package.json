{
  "name": "glass-assistant",
  "private": true,
  "version": "0.10.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --import tsx --test test/**/*.test.ts",
    "build": "tsc --noEmit && vite build --base=/app/ --outDir dist",
    "build:ehpk": "tsc --noEmit && vite build --mode ehpk --base=./ --outDir dist-ehpk",
    "preview": "vite preview",
    "pack": "npm run build:ehpk && evenhub pack app.json dist-ehpk -o glass-assistant-v0.10.6.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "tsx": "^4.20.3",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
